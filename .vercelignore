# Keep local crawl/source artifacts out of Vercel deploy uploads.
knowledge/vercel-academy/raw/
sqlite_mcp_server.db

# Local dependency/build/test artifacts.
node_modules/
dist/
.astro/
coverage/
playwright-report/
test-results/
tmp/
.worktrees/
.vercel/

# Generated evidence and local verification output are rebuilt by the release
# workflow; uploading them both slows production releases and can exceed
# Vercel's per-deployment file limit. Production archive deployments use
# scripts/prepare-vercel-deploy-stage.sh to add only the signed inputs needed
# by the fail-closed MRX1000 release gate.
artifacts/*
reports/*

# The icon-library React sources and master SVGs are authoring inputs only.
# Runtime code has no imports of them; retain optimized SVG and PNG public
# assets while avoiding hundreds of non-serving deployment entries.
public/assets/icons/react/
public/assets/icons/*/svg/

# Planning artifacts are not part of the public Vercel site. Keep only the
# hash-bound governance receipts required by the fail-closed release gate.
docs/*
!docs/governance
docs/governance/*
!docs/governance/mrx1000-owner-continuous-publication-directive-2026-08-04.md
scripts/audit-staged-content.mjs

# Remote builds need the same narrow signed inputs as prepare-vercel-deploy-stage.sh.
tests/
scripts/admit-mrx1000-*
!artifacts/mrx1000-release-10
