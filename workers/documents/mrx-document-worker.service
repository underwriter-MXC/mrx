[Unit]
Description=MRX private document scanning and OCR worker
After=network-online.target clamav-freshclam.service
Wants=network-online.target

[Service]
Type=simple
User=mrx-worker
Group=mrx-worker
WorkingDirectory=/opt/mrx-document-worker
EnvironmentFile=/etc/mrx-document-worker.env
Environment=PORT=8080
ExecStart=/opt/mrx-document-worker/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8080 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/clamav
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
