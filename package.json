{
  "name": "mrx-web",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "type": "module",
  "description": "Mineral Rights Xchange public website (Astro 5 + Vercel behind Cloudflare)",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm build:sell-search-dashboard && pnpm build:llms && pnpm check:copy && pnpm content:check-headings && node compliance/scripts/check-compliance.mjs && astro check && astro build && pnpm check:copy:rendered && pnpm check:seo:rendered && pnpm check:grammar",
    "build:hetzner": "pnpm build:sell-search-dashboard && pnpm build:llms && pnpm check:copy && pnpm content:check-headings && DEPLOY_TARGET=hetzner node compliance/scripts/check-compliance.mjs && DEPLOY_TARGET=hetzner astro check && DEPLOY_TARGET=hetzner astro build && pnpm check:copy:rendered && pnpm check:seo:rendered && pnpm check:grammar",
    "build:vercel": "pnpm build:mrx1000:two-image-creative-briefs && pnpm build:mrx1000:asset-evidence && pnpm build:mrx1000:publication-manifest && pnpm build:mrx1000:review-artifacts && pnpm build:mrx1000:evidence-packets && bash -c 'if [ \"${MRX_SKIP_RELEASE_GATE:-0}\" != \"1\" ]; then pnpm check:mrx1000:release-gates; fi' && pnpm build:mrx1000:lifecycle-dashboard && pnpm build:sell-search-dashboard && pnpm build:llms && pnpm check:copy && pnpm content:check-headings && pnpm check:legal-release && DEPLOY_TARGET=vercel node compliance/scripts/check-compliance.mjs && DEPLOY_TARGET=vercel astro check && DEPLOY_TARGET=vercel astro build && pnpm verify:articles:two-image-build && pnpm check:copy:rendered && pnpm check:seo:rendered && pnpm check:grammar",
    "start:hetzner": "HOST=0.0.0.0 PORT=${PORT:-4321} node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:schema": "node scripts/lint-schema.mjs",
    "build:llms": "node scripts/build-llms-index.mjs",
    "build:mrx1000:evidence-packets": "node scripts/build-mrx1000-release-10-evidence-packets.mjs",
    "build:mrx1000:two-image-creative-briefs": "node scripts/build-mrx-1000-hero-share-creative-briefs.mjs",
    "review:mrx1000:two-image": "node scripts/build-mrx1000-two-image-review-artifacts.mjs",
    "rebind:mrx1000:two-image": "node scripts/rebind-mrx1000-two-image-release.mjs --write",
    "assets:articles:two-image": "node scripts/retrofit-mrx-article-images.mjs --write",
    "build:mrx1000:asset-evidence": "node scripts/build-mrx1000-release-10-asset-evidence.mjs",
    "build:mrx1000:publication-manifest": "node scripts/build-mrx1000-release-10-publication-manifest.mjs",
    "build:mrx1000:review-artifacts": "node scripts/assemble-mrx1000-release-10-review-artifacts.mjs",
    "build:mrx1000:lifecycle-dashboard": "node scripts/build-mrx1000-lifecycle-dashboard.mjs",
    "build:sell-search-dashboard": "node scripts/build-mrx-sell-search-dashboard.mjs",
    "check:mrx1000:release-gates": "node scripts/check-mrx1000-release-gates.mjs",
    "audit:staged-content": "node scripts/audit-staged-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --minWorkers=1 --maxWorkers=2",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:vercel && node scripts/stage-playwright-build-artifacts.mjs && playwright test",
    "test:owner-profiles:10": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/run-owner-profiles-10.mjs",
    "test:ask-tommy:100": "node scripts/run-ask-tommy-100.mjs",
    "test:ask-tommy:fixtures": "node scripts/run-ask-tommy-100.mjs --dry-run",
    "verify:ghl": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-ghl-connection.mjs",
    "configure:ghl": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/configure-ghl-business-plan.mjs",
    "configure:ghl:apply": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/configure-ghl-business-plan.mjs --apply",
    "configure:ghl:apply:fields": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/configure-ghl-business-plan.mjs --apply --fields-only",
    "verify:supabase": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-supabase-connection.mjs",
    "verify:document-worker": "node scripts/verify-document-worker.mjs",
    "mcp:stdio": "node --env-file-if-exists=.env --env-file-if-exists=.env.local mcp/stdio.mjs",
    "mcp:http": "node --env-file-if-exists=.env --env-file-if-exists=.env.local mcp/http.mjs",
    "verify:mcp": "node scripts/verify-mrx-mcp.mjs",
    "verify:mrx1000:pilot-stage": "node scripts/verify-mrx1000-pilot-stage.mjs",
    "verify:articles:two-image-build": "node scripts/verify-mrx-article-two-image-build.mjs",
    "test:mcp": "vitest run tests/unit/mrx-mcp.spec.ts",
    "db:validate": "node scripts/validate-supabase-migration.mjs",
    "assets:homepage": "node scripts/build-homepage-assets.mjs",
    "assets:article-heroes": "node scripts/sync-article-heroes.mjs --download --apply",
    "assets:article-heroes:check": "node scripts/sync-article-heroes.mjs --check",
    "content:normalize-headings": "node scripts/normalize-post-headings.mjs",
    "content:check-headings": "node scripts/normalize-post-headings.mjs --check",
    "content:build-ledger": "node scripts/build-mrx-1000-content-ledger.mjs",
    "check-compliance": "node compliance/scripts/check-compliance.mjs",
    "check:copy": "node scripts/check-visible-copy.mjs",
    "check:copy:rendered": "node scripts/check-visible-copy.mjs --rendered",
    "check:seo:rendered": "node scripts/check-rendered-seo.mjs",
    "check:grammar": "node scripts/check-rendered-grammar.mjs",
    "check:legal-release": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-legal-release-gates.mjs",
    "icons:generate": "python3 scripts/generate_mrx_icon_library.py",
    "regenerate-lexicons": "node scripts/regenerate-lexicons.mjs",
    "migrate-wp": "node scripts/migrate-wp.mjs",
    "import:wp-articles": "node scripts/import-wp-articles.mjs",
    "ci": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.2.1",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/vercel": "^9.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.52.0",
    "astro": "^5.1.0",
    "libphonenumber-js": "^1.13.8",
    "openai": "^6.46.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "schema-dts": "^1.1.0",
    "tinyglobby": "^0.2.0",
    "tslib": "^2.8.1",
    "ws": "8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "harper.js": "^2.4.0",
    "pgsql-parser": "^17.9.16",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
