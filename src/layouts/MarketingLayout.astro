---
/**
 * MarketingLayout. For marketing/legal pages. Adds the Hero,
 * optional FAQ block slot, and CTA slot.
 * Inherits everything from BaseLayout.
 * Accepts disclaimerTop for frontmatter compatibility, but the global
 * top disclosure banner is intentionally no longer rendered here.
 */
import BaseLayout from './BaseLayout.astro';
import type { Crumb } from '../structured-data/breadcrumb';
import type { FaqPair } from '../lib/astro/content';
import { faqPage } from '../structured-data/faq';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  robots?: string;
  pageType?: 'home' | 'marketing' | 'blog' | 'post' | 'utility';
  pageCategory?: string;
  previousPath?: string;
  nextPath?: string;
  breadcrumbs?: Crumb[];
  /** Deprecated: retained for frontmatter compatibility; top disclosures are no longer rendered. */
  disclaimerTop?: boolean;
  /** Optional FAQ pairs that should emit FAQPage JSON-LD. */
  faq?: FaqPair[];
  hideHeader?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  noindex,
  robots,
  pageType = 'marketing',
  pageCategory,
  previousPath,
  nextPath,
  breadcrumbs,
  faq,
  hideHeader = false,
} = Astro.props;

const extraJsonLd = faq && faq.length > 0 ? [faqPage(faq)] : [];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogImage={ogImage}
  noindex={noindex}
  robots={robots}
  pageType={pageType}
  pageCategory={pageCategory}
  previousPath={previousPath}
  nextPath={nextPath}
  breadcrumbs={breadcrumbs}
  jsonLd={extraJsonLd}
  hideHeader={hideHeader}
>
  <slot />
</BaseLayout>
