---
import PillarArchivePage from '../../../../components/organisms/PillarArchivePage.astro';
import { getPillarArchiveStaticPaths } from '../../../../lib/pillar-inventory';

export const prerender = true;
const PILLAR_ID = 'mineral-rights-taxes' as const;

export async function getStaticPaths() {
  return getPillarArchiveStaticPaths('mineral-rights-taxes');
}

const currentPage = Number(Astro.params.page);
---

<PillarArchivePage
  pillarId={PILLAR_ID}
  currentPage={currentPage}
  title="Mineral Rights Taxes and 1031 Exchanges · MRX"
  description="Browse the full MRX mineral-rights tax archive: 1031 exchange eligibility, severance and capital-gains questions, and the records to take to a qualified adviser."
/>
