---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import IntentPage from '../components/organisms/IntentPage.astro';
import { ownerSituations } from '../data/ownerSituations';

export const prerender = true;
export function getStaticPaths() {
  return ownerSituations.map((situation) => ({
    params: { situation: situation.slug },
    props: { situation },
  }));
}

const { situation } = Astro.props;
---

<MarketingLayout
  title={situation.seoTitle}
  description={situation.description}
  path={`/${situation.slug}/`}
  pageType="marketing"
  pageCategory="owner-situation"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: situation.title, path: `/${situation.slug}/` },
  ]}
>
  <IntentPage
    eyebrow={situation.eyebrow}
    title={situation.title}
    lede={situation.description}
    answerTitle={situation.answerTitle}
    answerPoints={situation.answerPoints}
    prompt={situation.prompt}
    sections={situation.sections}
  />
</MarketingLayout>
