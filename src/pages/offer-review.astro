---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import IntentPage from '../components/organisms/IntentPage.astro';
import OfferReviewDecisionFramework from '../components/organisms/OfferReviewDecisionFramework.astro';
import StaticPillarInventory from '../components/organisms/StaticPillarInventory.astro';
import { getPillarInventoryPage } from '../lib/pillar-inventory';
export const prerender = true;
const inventory = await getPillarInventoryPage('offer-review');
---

<MarketingLayout
  title="Is My Mineral Rights Offer Fair? · MRX"
  description="Test whether a mineral-rights offer is fair by comparing the exact interest, price assumptions, adjustment rights, deed scope, and closing terms."
  path="/offer-review/"
  pageType="marketing"
  pageCategory="seller-intent"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Review My Offer', path: '/offer-review/' },
  ]}
>
  <IntentPage
    eyebrow="Fair mineral rights offer review"
    title="Is my mineral rights offer fair?"
    lede="You cannot tell from the headline amount alone. Define the exact property and rights, identify every price assumption and adjustment right, then compare the full closing terms before you respond or sign."
    answerTitle="A fair comparison starts here"
    answerPoints={[
      'The exact acres, depths, counties, and interests included',
      'Whether the amount is gross, net, per acre, or total',
      'What the buyer can change after title or diligence review',
      'Closing date, payment conditions, assignments, and termination rights',
    ]}
    prompt="I received a mineral rights offer and want to know whether it is fair. Help me organize the terms and questions before I respond."
    sections={[
      {
        title: 'Start with the property description',
        paragraphs: [
          'Confirm that the offer covers only the interests you intend to discuss. Look for county, survey, section, township, range, unit, well, depth, and net-acre language. Broad wording deserves careful review.',
        ],
      },
      {
        title: 'Find every adjustment right',
        paragraphs: [
          'Some offers allow the buyer to revise the amount after reviewing ownership, title, production, or other records. Identify who decides, how changes are calculated, whether you can reject a revision, and what happens to signed documents.',
        ],
        bullets: [
          'Ask whether the headline amount assumes a specific net acreage.',
          'Identify deposits, option periods, exclusivity, or extensions.',
          'Keep copies of every version and written communication.',
        ],
      },
      {
        title: 'Know when to involve a professional',
        paragraphs: [
          'Title, probate, conveyance, tax, and contract questions can be state-specific. Laurel can explain common terms and help prepare a question list, but an attorney or tax professional should address individualized conclusions.',
        ],
      },
    ]}
  />
  <OfferReviewDecisionFramework />
  <StaticPillarInventory inventory={inventory} />
</MarketingLayout>
