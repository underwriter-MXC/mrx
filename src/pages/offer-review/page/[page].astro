---
import PillarArchivePage from '../../../components/organisms/PillarArchivePage.astro';
import { getPillarArchiveStaticPaths } from '../../../lib/pillar-inventory';

export const prerender = true;
const PILLAR_ID = 'offer-review' as const;

export async function getStaticPaths() {
  return getPillarArchiveStaticPaths('offer-review');
}

const currentPage = Number(Astro.params.page);
---

<PillarArchivePage
  pillarId={PILLAR_ID}
  currentPage={currentPage}
  title="Mineral Rights Offer Review Articles · MRX"
  description="Browse the full MRX offer-review archive: buyer comparisons, written terms, pricing context, risk questions, and practical checks before responding."
/>
