---
import { getCollection, type CollectionEntry } from 'astro:content';
import CategoryArchivePage from '../../../components/organisms/CategoryArchivePage.astro';
import { paginateArchive } from '../../../lib/archive-pagination';
import { isPublishedPost } from '../../../lib/content-graph';

export const prerender = true;

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((category) => ({
    params: { category: category.data.slug },
    props: { category },
  }));
}

interface Props {
  category: CollectionEntry<'categories'>;
}

const { category } = Astro.props;
const [categories, allPosts] = await Promise.all([
  getCollection('categories'),
  getCollection(
    'posts',
    (post) => isPublishedPost(post) && post.data.category === category.data.id,
  ),
]);
allPosts.sort(
  (a, b) =>
    new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime() ||
    a.id.localeCompare(b.id),
);
const page = paginateArchive(allPosts, 1);
---

<CategoryArchivePage {...page} category={category} categories={categories} />
