---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import CitedAnswer from '../components/molecules/CitedAnswer.astro';
import OfferComparisonTool from '../components/organisms/OfferComparisonTool.astro';

export const prerender = true;

const faqs = [
  {
    question: 'Does this worksheet tell me which mineral rights offer to accept?',
    answer:
      'No. It compares only the terms you enter and identifies missing or unclear items. It does not verify title, estimate mineral value, interpret a contract, or provide legal, tax, appraisal, or investment advice.',
  },
  {
    question: 'Does MRX receive the amounts I enter?',
    answer:
      'No. The comparison runs in your browser and is not submitted to MRX. If you later choose to ask Tommy, create a profile, or request an underwriter review, you decide what information to share.',
  },
  {
    question: 'What should I compare besides the headline price?',
    answer:
      'Compare disclosed fees and deductions, the exact rights and depths conveyed, buyer adjustment rights, closing and payment conditions, document stage, and any termination, exclusivity, or extension language.',
  },
  {
    question: 'Can two offers with the same price produce different outcomes?',
    answer:
      'Yes. Different fees, acreage assumptions, rights conveyed, adjustment clauses, closing conditions, or document stages can make identical headline numbers materially different.',
  },
];
---

<MarketingLayout
  title="Compare Mineral Rights Offers · MRX"
  description="Compare two mineral-rights offers by net proceeds, fees, rights conveyed, adjustment terms, document stage, and closing timing in a private worksheet."
  path="/mineral-rights-offer-comparison/"
  pageType="marketing"
  pageCategory="seller-intent"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Review My Offer', path: '/offer-review/' },
    { name: 'Offer Comparison', path: '/mineral-rights-offer-comparison/' },
  ]}
  faq={faqs}
>
  <section class="mrx-page-hero">
    <div class="container mrx-page-hero__grid">
      <div>
        <p class="mrx-eyebrow">Mineral rights offer comparison</p>
        <h1>Compare two offers beyond the headline price.</h1>
        <p>
          See the provisional net from the amounts you enter, surface unclear terms, and leave with
          a focused question list before MRX asks for an account or contact information.
        </p>
        <div class="mrx-home-actions">
          <a class="mrx-primary" href="#offer-tool-title">Compare my offers</a>
          <a class="mrx-secondary" href="/offer-review/">Read the offer-review guide</a>
        </div>
      </div>
      <CitedAnswer
        text="A useful mineral-rights offer comparison starts with more than the headline amount. First compare the provisional net after disclosed fees or deductions. Then identify the exact acres, counties, tracts, depths, and interests the buyer would receive. Read for any right to reduce the amount after title, acreage, production, or diligence review. Compare payment conditions, closing timing, extensions, termination rights, and whether each number appears in a complete agreement, a letter of intent, or only an email or conversation. An offer with a higher headline can leave an owner with less money or broader rights conveyed, while two equal numbers can carry very different uncertainty. This private worksheet organizes those disclosed terms and produces questions to ask; it does not estimate the underlying value of the minerals or determine which agreement is best. Title, deed, contract, tax, and estate questions can be state-specific, so controlling documents and qualified professionals remain important. Owners who want a second look can ask Tommy for a plain-language explanation or request a free underwriter review after seeing the worksheet results. The owner still decides what to share."
        sources={[
          { label: 'MRX offer-review guide', href: '/offer-review/' },
          { label: 'MRX published methodology', href: '/methodology/' },
          { label: 'MRX editorial and source policy', href: '/editorial-policy/' },
        ]}
      />
    </div>
  </section>

  <OfferComparisonTool />

  <section class="mrx-section" aria-labelledby="offer-comparison-faq">
    <div class="container mrx-prose-grid">
      <div>
        <p class="mrx-eyebrow">Use the result carefully</p>
        <h2 id="offer-comparison-faq">What this comparison can and cannot show</h2>
        <p>
          It can organize the amounts and written terms you enter, expose unanswered questions, and
          make a follow-up conversation more efficient. It cannot confirm ownership, forecast future
          production, value a tract, interpret a deed, or replace a complete document review.
        </p>
        <h2>Bring the complete paper trail</h2>
        <p>
          If you request an underwriter review, the most useful starting records are the complete
          offer and exhibits, recent royalty statements, a lease or division order if available, and
          any deed or probate record that helps identify the interest. Missing documents are normal;
          MRX can help turn unknowns into a checklist.
        </p>
      </div>
      <aside class="mrx-side-cta">
        <p class="mrx-eyebrow">Stay in control</p>
        <h3>Use the free tool first.</h3>
        <p>
          Share contact information only if you want to save the next steps or ask an underwriter to
          review the documents.
        </p>
        <a class="mrx-primary" href="#offer-tool-title">Return to the worksheet</a>
      </aside>
    </div>
  </section>
</MarketingLayout>
