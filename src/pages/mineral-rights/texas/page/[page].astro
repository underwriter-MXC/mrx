---
import PillarArchivePage from '../../../../components/organisms/PillarArchivePage.astro';
import { getPillarArchiveStaticPaths } from '../../../../lib/pillar-inventory';

export const prerender = true;
const PILLAR_ID = 'texas-mineral-rights' as const;

export async function getStaticPaths() {
  return getPillarArchiveStaticPaths('texas-mineral-rights');
}

const currentPage = Number(Astro.params.page);
---

<PillarArchivePage
  pillarId={PILLAR_ID}
  currentPage={currentPage}
  title="Texas Mineral Rights Articles · MRX"
  description="Browse the full MRX Texas mineral-rights archive: county and basin context, public records, ownership documents, production questions, and local owner decisions."
/>
