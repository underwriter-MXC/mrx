---
import { getCollection, getEntry } from 'astro:content';
import AuthorArchivePage from '../../components/organisms/AuthorArchivePage.astro';
import { paginateArchive } from '../../lib/archive-pagination';
import { isPublishedPost } from '../../lib/content-graph';

export const prerender = true;

const author = await getEntry('authors', 'mrx-editorial-team');
if (!author) throw new Error('The MRX Editorial Team author entry is required.');
const posts = (await getCollection('posts', isPublishedPost)).sort(
  (a, b) =>
    new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime() ||
    a.id.localeCompare(b.id),
);
const page = paginateArchive(posts, 1);
---

<AuthorArchivePage {...page} author={author} />
