---
/**
 * CtaBlock organism. Full-width CTA panel used at the end of marketing
 * pages. Carries the primary CTA + a small "no card required" reassurance.
 */
import CtaLink from '../atoms/CtaLink.astro';

interface Props {
  title: string;
  body: string;
  primaryCta: { label: string; href: string; ctaName: string; rel?: string };
  secondaryCta?: {
    label: string;
    href: string;
    ctaName: string;
    openTommy?: boolean;
    rel?: string;
  };
  reassurance?: string;
}

const {
  title,
  body,
  primaryCta,
  secondaryCta,
  reassurance = 'No card required. No obligation. Confidential review.',
} = Astro.props;
---

<section class="container">
  <div class="cta-block">
    <h2>{title}</h2>
    <p>{body}</p>
    <div class="row" style="justify-content: center;">
      <CtaLink
        ctaName={primaryCta.ctaName}
        href={primaryCta.href}
        rel={primaryCta.rel}
        variant="primary"
        size="lg"
      >
        {primaryCta.label}
      </CtaLink>
      {
        secondaryCta && (
          <CtaLink
            ctaName={secondaryCta.ctaName}
            href={secondaryCta.href}
            variant="ghost"
            size="lg"
            openTommy={secondaryCta.openTommy}
            rel={secondaryCta.rel}
          >
            {secondaryCta.label}
          </CtaLink>
        )
      }
    </div>
    <p class="text text--sm" style="color: var(--color-ink-300); margin-top: var(--space-3);">
      {reassurance}
    </p>
  </div>
</section>

<style>
  .cta-block :global(.btn--ghost) {
    color: var(--color-white);
    border-color: var(--color-white);
  }

  .cta-block :global(.btn--ghost:hover),
  .cta-block :global(.btn--ghost:focus-visible) {
    background: var(--color-white);
    color: var(--color-brand-900);
  }
</style>
