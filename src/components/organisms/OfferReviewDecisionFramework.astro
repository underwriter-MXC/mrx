---
const fairOfferArticle = '/blog/how-to-know-if-your-mineral-rights-offer-is-fair/';
const competingOffersArticle =
  '/blog/what-to-do-when-you-have-competing-offers-on-your-mineral-rights-a-guide/';
const clawbackArticle = '/blog/what-is-a-clawback-clause-in-a-mineral-rights-sale/';

const offerReviewStartingPoints = [
  {
    href: fairOfferArticle,
    question: 'Is the offer fair?',
    description: 'Compare the exact interest, written assumptions, adjustment rights, and closing conditions before judging the headline amount.',
  },
  {
    href: competingOffersArticle,
    question: 'What if I have more than one offer?',
    description: 'Put each offer on the same property scope and written-term basis before comparing the numbers.',
  },
  {
    href: '/blog/mineral-rights-offer-sender-identity-cross-check/',
    question: 'Who sent the offer?',
    description: 'Organize the sender details shown in the offer, selected public records, and independently located contact information.',
  },
  {
    href: '/blog/mineral-rights-offer-version-control-and-deadline-register/',
    question: 'Which version am I reviewing?',
    description: 'Keep every written offer, revised attachment, received time, and stated deadline in a separate record row.',
  },
  {
    href: '/blog/how-to-spot-predatory-mineral-rights-offers/',
    question: 'What pressure signs should slow me down?',
    description: 'Turn urgency, missing terms, identity gaps, and unusual payment requests into neutral verification questions.',
  },
  {
    href: '/blog/what-is-a-mineral-rights-purchase-agreement-and-what-should-it-include/',
    question: 'What is in the purchase agreement?',
    description: 'Identify agreement sections to read and questions to raise without treating this page as legal advice.',
  },
] as const;

const offerReviewAdvancedWorksheets = [
  {
    href: '/blog/property-scope-crosswalk-mineral-rights-offers/',
    title: 'Property scope crosswalk',
    description: 'Check whether two offers describe the same county, tract, depth, unit, and retained rights.',
  },
  {
    href: '/blog/mineral-rights-offer-correspondence-index/',
    title: 'Offer correspondence index',
    description: 'Locate messages, attachments, contacts, and source references without exposing private correspondence.',
  },
  {
    href: '/blog/mineral-rights-retained-evidence-source-scope-worksheet/',
    title: 'Retained evidence source scope',
    description: 'Record what one retained artifact can and cannot support before it is used in a review.',
  },
  {
    href: '/blog/how-title-defects-change-mineral-rights-offer/',
    title: 'Title-adjustment questions',
    description: 'Separate title-review adjustments from owner-specific title conclusions that need qualified counsel.',
  },
] as const;

const offerReviewSourceContext = [
  {
    href: 'https://www.rrc.texas.gov/about-us/faqs/oil-gas-faq/production-data-query-system-faqs/',
    label: 'RRC production-data limits',
    note: 'RRC states Texas production is generally reported by lease rather than by individual well.',
  },
  {
    href: 'https://www.rrc.texas.gov/about-us/faqs/royalties-faq/',
    label: 'RRC royalty authority limits',
    note: 'RRC identifies many lease and royalty matters as outside Commission authority.',
  },
  {
    href: 'https://comptroller.texas.gov/transparency/open-data/cpa-databases/',
    label: 'Texas Comptroller entity-status context',
    note: 'The Comptroller describes Taxable Entity Search as a right-to-transact-business status source.',
  },
  {
    href: 'https://www.sos.state.tx.us/corp/generalfaqs.shtml',
    label: 'Texas Secretary of State business records',
    note: 'SOS business-organization FAQs provide public-record context for entity and registered-agent questions.',
  },
] as const;
---

<section class="offer-framework" aria-labelledby="fair-offer-answer">
  <div class="container">
    <div class="offer-framework__answer">
      <p class="offer-framework__eyebrow">The direct answer</p>
      <h2 id="fair-offer-answer">Is my mineral rights offer fair?</h2>
      <p>
        The headline amount alone cannot answer that question. An offer is ready for a meaningful
        comparison only after the exact interest, acres, depths, payment assumptions, adjustment
        rights, closing conditions, and rights retained are defined. A higher number can still cover
        more property, carry broader adjustment rights, or provide less closing certainty.
      </p>
      <p>
        Use the four-part test below to identify what is known, what is missing, and which questions
        must be answered before you sign. It is a decision framework, not a certified valuation or a
        legal, tax, title, reserve, engineering, or fairness opinion.
      </p>
    </div>

    <div
      class="offer-framework__table-wrap"
      tabindex="0"
      aria-label="Four-part mineral rights offer review table"
    >
      <table class="offer-framework__table">
        <thead>
          <tr>
            <th scope="col">Fairness test</th>
            <th scope="col">What to compare</th>
            <th scope="col">Question to ask</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">1. Same asset</th>
            <td
              >County, legal description, net ownership, formations, depths, producing and
              non-producing interests</td
            >
            <td>Do both sides mean the same property and rights?</td>
          </tr>
          <tr>
            <th scope="row">2. Explainable price</th>
            <td
              >Total amount, stated acreage, current income, production context, market assumptions,
              deductions</td
            >
            <td>Which facts and assumptions produced the number?</td>
          </tr>
          <tr>
            <th scope="row">3. Adjustment risk</th>
            <td
              >Title reductions, diligence period, exclusivity, termination rights, deposits, signed
              documents</td
            >
            <td>Who can change or cancel what, and when?</td>
          </tr>
          <tr>
            <th scope="row">4. Closing certainty</th>
            <td
              >Funding, payment timing, deed delivery, effective date, representations, post-closing
              obligations</td
            >
            <td>What must happen before payment becomes final?</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="offer-framework__actions">
      <a class="offer-framework__primary" href="/mineral-rights-offer-comparison/">
        Compare two offers side by side
      </a>
      <a class="offer-framework__secondary" href="/book/">Request a free underwriter review</a>
    </div>
  </div>
</section>

<section class="offer-framework offer-framework--alt" aria-labelledby="why-owners-are-vulnerable">
  <div class="container offer-framework__grid">
    <div>
      <p class="offer-framework__eyebrow">Why owners can be vulnerable</p>
      <h2 id="why-owners-are-vulnerable">
        The information gap is usually bigger than the price gap
      </h2>
      <p>
        Many owners receive an unsolicited offer before they have gathered the records needed to
        compare it. The buyer may already have specialists, public-data workflows, agreement forms,
        and transaction experience. The owner may have only a letter, a deadline, and an unfamiliar
        legal description.
      </p>
      <ul>
        <li>
          <strong>Headline compression:</strong> a single number hides which acres, depths, payments,
          and rights are included.
        </li>
        <li>
          <strong>Unequal preparation:</strong> one side may have reviewed production and title indicators
          before the owner knows which records to request.
        </li>
        <li>
          <strong>Time pressure:</strong> urgency can shorten the time available to compare documents
          or consult a qualified professional.
        </li>
        <li>
          <strong>Late adjustments:</strong> the amount may remain subject to title, diligence, or agreement
          terms after the owner has emotionally anchored to it.
        </li>
        <li>
          <strong>False comparisons:</strong> two offers may appear different because they describe different
          interests, not because one buyer pays more for the same asset.
        </li>
      </ul>
    </div>
    <aside class="offer-framework__checklist">
      <h3>Bring what you have</h3>
      <p>Missing records are common. Start with any of these:</p>
      <ul>
        <li>Every page and attachment from the written offer</li>
        <li>Mineral deed, probate record, trust record, or other conveyance</li>
        <li>Lease, amendments, division order, and recent royalty statements</li>
        <li>State, county, legal description, operator, unit, or well identifiers</li>
        <li>Emails or letters describing acreage, price, deadlines, or revisions</li>
      </ul>
      <a href="/how-it-works/">See what the free review covers →</a>
    </aside>
  </div>
</section>

<section class="offer-framework" aria-labelledby="offer-review-start-here">
  <div class="container">
    <p class="offer-framework__eyebrow">Start here</p>
    <h2 id="offer-review-start-here">Use the right supporting page for your next question</h2>
    <div class="offer-framework__cards">
      <article>
        <h3><a href={fairOfferArticle}>How to know if an offer is fair</a></h3>
        <p>
          Work through the exact interest, assumptions, agreement, deed, buyer, and closing
          sequence.
        </p>
      </article>
      <article>
        <h3><a href={competingOffersArticle}>How to compare competing offers</a></h3>
        <p>Normalize the asset and written terms before comparing headline amounts.</p>
      </article>
      <article>
        <h3><a href={clawbackArticle}>What a clawback clause can change</a></h3>
        <p>Identify language that may reduce or recover part of the stated transaction amount.</p>
      </article>
      <article>
        <h3><a href="/mineral-rights-value/">What affects mineral rights value</a></h3>
        <p>
          Separate ownership, production, location, timing, and market inputs from unsupported
          guesses.
        </p>
      </article>
      <article>
        <h3><a href="/sell-mineral-rights/">Options for selling mineral rights</a></h3>
        <p>Compare a full sale, partial sale, or holding before choosing a transaction path.</p>
      </article>
      <article>
        <h3><a href="/methodology/">How MRX states assumptions and limits</a></h3>
        <p>See the evidence boundary for a directional underwriter review.</p>
      </article>
    </div>
    <div class="offer-framework__sources">
      <h3>Public-source context</h3>
      <p>
        Public production data can add context but does not establish private title, future
        production, or an owner-specific transaction answer. For source limitations and royalty
        authority boundaries, see
        the <a
          href="https://www.rrc.texas.gov/about-us/faqs/oil-gas-faq/production-data-query-system-faqs/"
          >Railroad Commission of Texas production-data FAQ</a
        >
        and the <a href="https://www.rrc.texas.gov/about-us/faqs/royalties-faq/"
          >Railroad Commission royalties FAQ</a
        >.
      </p>
    </div>
  </div>
</section>

<section class="offer-framework" aria-labelledby="offer-resource-hub">
  <div class="container">
    <p class="offer-framework__eyebrow">Plain-language offer-review hub</p>
    <h2 id="offer-resource-hub">Start with one owner question, then preserve the records</h2>
    <p>
      Start with the question closest to what arrived in the mail, email, or portal. These pages
      organize facts and next questions; they do not decide legal, tax, title, appraisal,
      engineering, or transaction outcomes for a specific owner.
    </p>

    <div class="offer-framework__resource-grid" data-offer-resource-hub>
      {
        offerReviewStartingPoints.map((resource, index) => (
          <article class="offer-framework__resource-card" data-offer-resource-card>
            <p class="offer-framework__resource-index">{String(index + 1).padStart(2, '0')}</p>
            <h3>
              <a href={resource.href}>{resource.question}</a>
            </h3>
            <p>{resource.description}</p>
          </article>
        ))
      }
    </div>

    <div class="offer-framework__advanced">
      <h3>Advanced worksheets after the starting point</h3>
      <p>
        Use these only after the owner question is clear and the relevant offer records are
        preserved. Worksheets keep evidence organized without interpreting private records.
      </p>
      <div class="offer-framework__cards">
        {
          offerReviewAdvancedWorksheets.map((worksheet) => (
            <article>
              <h3><a href={worksheet.href}>{worksheet.title}</a></h3>
              <p>{worksheet.description}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="offer-framework__sources">
      <h3>Bounded public-source context</h3>
      <p>
        These sources support only the public-record limits named below. They are not buyer-trust,
        funding, title, value, tax, or contract conclusions.
      </p>
      <ul class="offer-framework__source-list">
        {
          offerReviewSourceContext.map((source) => (
            <li>
              <a href={source.href}>{source.label}</a>: {source.note}
            </li>
          ))
        }
      </ul>
      <p>
        If an owner’s answer depends on an unverified record, missing exhibit, personal tax result,
        legal interpretation, title conclusion, or a value opinion, the hub routes the question to
        <a href="/book/">MRX underwriter review</a> or an outside qualified professional instead of
        supplying a personalized conclusion.
      </p>
    </div>
  </div>
</section>

