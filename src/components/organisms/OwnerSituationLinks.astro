---
/** Crawlable routes for the focused owner-situation pages. */
import { ownerSituations } from '../../data/ownerSituations';

const labels: Record<string, string> = {
  'estate-heir': 'Inherited through an estate',
  'confused-inheritor': 'Not sure what you inherited',
  'suspicious-seller': 'Reviewing a buyer offer',
  'cash-strapped-owner': 'Selling when timing matters',
  'suspense-funds': 'Royalties held in suspense',
  '1031-exchange': 'Preparing Section 1031 questions',
  'reluctant-environmentalist': 'Environmental concerns',
  'multi-state-inheritor': 'A multi-state inheritance',
};
---

<section class="owner-situations" aria-labelledby="owner-situations-title">
  <div class="container">
    <p class="owner-situations__eyebrow">Start with your situation</p>
    <h2 id="owner-situations-title">Choose the question closest to yours</h2>
    <p class="owner-situations__lede">
      These focused guides organize the records, tradeoffs, and professional questions that often
      come before a mineral-rights decision.
    </p>
    <ul>
      {
        ownerSituations.map((situation) => (
          <li>
            <a href={`/${situation.slug}/`}>
              <strong>{labels[situation.slug] ?? situation.eyebrow}</strong>
              <span>{situation.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .owner-situations {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid var(--color-ink-100, #d9e0e4);
    background: var(--color-bg-alt, #f6f3ec);
  }

  .owner-situations__eyebrow {
    margin: 0 0 var(--space-2, 0.5rem);
    color: var(--color-accent-700, #b06a00);
    font-size: var(--fs-xs, 0.78rem);
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .owner-situations h2 {
    max-width: 24ch;
    margin: 0;
    color: var(--color-brand-900, #071e34);
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    line-height: 1.1;
  }

  .owner-situations__lede {
    max-width: 68ch;
    margin: var(--space-3, 0.85rem) 0 var(--space-6, 2rem);
    color: var(--color-ink-600, #4f626f);
    line-height: 1.6;
  }

  .owner-situations ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .owner-situations a {
    display: grid;
    height: 100%;
    gap: var(--space-2, 0.5rem);
    border: 1px solid var(--color-ink-100, #d9e0e4);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-5, 1.25rem);
    color: var(--color-brand-900, #071e34);
    background: var(--color-white, #fff);
    text-decoration: none;
  }

  .owner-situations a:hover,
  .owner-situations a:focus-visible {
    border-color: var(--color-accent-700, #b06a00);
    box-shadow: 0 10px 28px rgba(7, 30, 52, 0.1);
  }

  .owner-situations span {
    color: var(--color-ink-600, #4f626f);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .owner-situations ul {
      grid-template-columns: 1fr;
    }
  }
</style>
