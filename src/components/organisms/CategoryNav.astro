---
/**
 * CategoryNav organism. 7 categories in a horizontal nav.
 */
import type { CollectionEntry } from 'astro:content';
import Tag from '../atoms/Tag.astro';

interface Props {
  categories: CollectionEntry<'categories'>[];
  currentSlug?: string;
}

const { categories, currentSlug } = Astro.props;
---

<nav class="container category-nav" aria-label="Blog categories">
  <ul class="row">
    <li>
      <Tag>
        <a class="category-nav__link" href="/learning-center/">All</a>
      </Tag>
    </li>
    {
      categories.map((c) => (
        <li>
          <Tag>
            <a
              class="category-nav__link"
              href={`/blog/category/${c.data.slug}/`}
              aria-current={currentSlug === c.data.slug ? 'page' : undefined}
            >
              {c.data.label}
            </a>
          </Tag>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .category-nav {
    padding-block: var(--space-6);
  }

  .category-nav__link {
    color: inherit;
    text-decoration: none;
  }
</style>
