---
/**
 * FormSection organism. The /book or /free-guide form (reused for both).
 * The actual submit handling is in src/pages/api/{book,free-guide}.ts;
 * this component just renders the inputs. Stage 06 reserves the
 * form fields per compliance §9 (no SSN/DOB/full bank info).
 */
import {
  CALL_CONSENT_TEXT,
  GUIDE_DELIVERY_CONSENT_VERSION,
  GUIDE_DOWNLOAD_PATH,
  GUIDE_EMAIL_CONSENT_TEXT,
  GUIDE_SLUG,
  GUIDE_TITLE,
  MARKETING_EMAIL_CONSENT_TEXT,
  SMS_CONSENT_TEXT,
} from '../../lib/form';

interface Props {
  form: 'book' | 'free-guide';
  submitLabel: string;
  legend: string;
  compact?: boolean;
}

const { form, submitLabel, legend, compact = false } = Astro.props;
const action = form === 'book' ? '/api/book' : '/api/free-guide';
const isFreeGuide = form === 'free-guide';
const formClass = compact ? 'form form--compact' : 'form';
---

<form class={formClass} method="POST" action={action} aria-label={legend} data-form-kind={form}>
  <fieldset class="form__fieldset">
    <legend class="visually-hidden">{legend}</legend>

    {
      isFreeGuide && (
        <div class="form__intro" aria-live="polite">
          <strong>Email delivery only requires your email consent.</strong>
          <span>
            {' '}
            Optional marketing emails, texts, and AI/prerecorded calls are separate choices and are
            not required to receive the guide.
          </span>
        </div>
      )
    }

    {
      !isFreeGuide && (
        <>
          <div class="form__field">
            <label class="form__label" for={`${form}-firstName`}>
              First name
            </label>
            <input
              class="form__input"
              type="text"
              id={`${form}-firstName`}
              name="firstName"
              required
              autocomplete="given-name"
              maxlength="60"
            />
          </div>

          <div class="form__field">
            <label class="form__label" for={`${form}-lastName`}>
              Last name
            </label>
            <input
              class="form__input"
              type="text"
              id={`${form}-lastName`}
              name="lastName"
              required
              autocomplete="family-name"
              maxlength="60"
            />
          </div>
        </>
      )
    }

    <div class="form__field">
      <label class="form__label" for={`${form}-email`}>Email</label>
      <input
        class="form__input"
        type="email"
        id={`${form}-email`}
        name="email"
        required
        autocomplete="email"
        maxlength="120"
      />
    </div>

    {
      !isFreeGuide && (
        <>
          <div class="form__field">
            <label class="form__label" for={`${form}-phone`}>
              Phone (optional)
            </label>
            <input
              class="form__input"
              type="tel"
              id={`${form}-phone`}
              name="phone"
              autocomplete="tel"
              maxlength="30"
              aria-describedby={`${form}-phone-help`}
            />
            <span class="form__help" id={`${form}-phone-help`}>
              Used only for scheduling; we never share or sell contact data.
            </span>
          </div>

          <div class="form__field">
            <label class="form__label" for={`${form}-notes`}>
              Notes (optional)
            </label>
            <textarea
              class="form__textarea"
              id={`${form}-notes`}
              name="notes"
              maxlength="2000"
              placeholder="Anything we should know: county, royalty situation, offer in hand, etc."
            />
          </div>
        </>
      )
    }

    {
      isFreeGuide ? (
        <div class="form__field form__consents" aria-labelledby={`${form}-consent-heading`}>
          <h3 class="form__consent-heading" id={`${form}-consent-heading`}>
            Required guide delivery consent
          </h3>
          <label class="form__check">
            <input type="checkbox" name="consent" required />
            <span>{GUIDE_EMAIL_CONSENT_TEXT}</span>
          </label>
          <p class="form__help">
            By submitting, you agree to MRX’s <a href="/privacy-policy">Privacy Policy</a> and{' '}
            <a href="/terms/">Terms &amp; AI Disclosure</a>. We record consent choices, disclosure
            text/version, page URL, UTMs, server timestamp, and browser user agent for auditability.
          </p>
        </div>
      ) : (
        <div class="form__field">
          <label class="form__check">
            <input type="checkbox" name="consent" required />
            <span>
              I consent to Mineral Rights Xchange contacting me about an underwriter review. No card
              required. No obligation. I can opt out at any time.
            </span>
          </label>
        </div>
      )
    }

    {
      isFreeGuide && (
        <>
          <input type="hidden" name="requested_guide" value={GUIDE_SLUG} />
          <input type="hidden" name="guide_title" value={GUIDE_TITLE} />
          <input type="hidden" name="consent_version" value={GUIDE_DELIVERY_CONSENT_VERSION} />
          <input type="hidden" name="guide_email_consent_text" value={GUIDE_EMAIL_CONSENT_TEXT} />
          <input
            type="hidden"
            name="marketing_email_consent_text"
            value={MARKETING_EMAIL_CONSENT_TEXT}
          />
          <input type="hidden" name="sms_consent_text" value={SMS_CONSENT_TEXT} />
          <input type="hidden" name="call_consent_text" value={CALL_CONSENT_TEXT} />
          <input type="hidden" name="guide_download_path" value={GUIDE_DOWNLOAD_PATH} />
          <input type="hidden" name="consent_timezone_offset" value="" />
          <input type="hidden" name="consent_client_timestamp" value="" />
        </>
      )
    }

    <!-- Hidden fields for UTM tracking; populated by analytics.ts. -->
    <input type="hidden" name="utm_source" id={`${form}-utm_source`} value="" />
    <input type="hidden" name="utm_medium" id={`${form}-utm_medium`} value="" />
    <input type="hidden" name="utm_campaign" id={`${form}-utm_campaign`} value="" />
    <input type="hidden" name="utm_term" id={`${form}-utm_term`} value="" />
    <input type="hidden" name="utm_content" id={`${form}-utm_content`} value="" />
    <input type="hidden" name="page_url" id={`${form}-page_url`} value="" />
    <input type="hidden" name="page_title" id={`${form}-page_title`} value="" />

    {
      isFreeGuide && (
        <details class="form__optional-consents">
          <summary>Optional updates by email, text, or AI/prerecorded call</summary>
          <p class="form__help">These choices are not required to receive the guide.</p>
          <div class="form__field">
            <label class="form__label" for={`${form}-phone`}>
              Phone (required only for text or call consent)
            </label>
            <input
              class="form__input"
              type="tel"
              id={`${form}-phone`}
              name="phone"
              autocomplete="tel"
              maxlength="30"
              aria-describedby={`${form}-phone-help`}
            />
            <span class="form__help" id={`${form}-phone-help`}>
              Leave this blank if you do not want texts or calls.
            </span>
          </div>
          <label class="form__check">
            <input type="checkbox" name="marketing_email_consent" />
            <span>{MARKETING_EMAIL_CONSENT_TEXT}</span>
          </label>
          <label class="form__check">
            <input type="checkbox" name="sms_consent" data-requires-phone />
            <span>{SMS_CONSENT_TEXT}</span>
          </label>
          <label class="form__check">
            <input type="checkbox" name="call_consent" data-requires-phone />
            <span>{CALL_CONSENT_TEXT}</span>
          </label>
        </details>
      )
    }

    <div class="form__submit">
      <button type="submit" class="btn btn--primary btn--lg" data-cta-name={`${form}-submit`}>
        {submitLabel}
      </button>
    </div>

    <p class="form__help">
      <strong>No card required.</strong> No obligation. Confidential review. The intake is genuinely free;
      MRX will disclose in writing if it becomes a buyer in any resulting transaction.
    </p>
  </fieldset>
</form>

<style>
  .form__fieldset {
    display: contents;
    padding: 0;
    margin: 0;
    border: 0;
  }
</style>

<script>
  function attachUtmCopy(form: HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      const url = new URL(window.location.href);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach((k) => {
        const el = form.querySelector<HTMLInputElement>(`input[name="${k}"]`);
        if (el && !el.value) {
          el.value = url.searchParams.get(k) ?? '';
        }
      });
      const pageUrl = form.querySelector<HTMLInputElement>('input[name="page_url"]');
      if (pageUrl) pageUrl.value = window.location.href;
      const pageTitle = form.querySelector<HTMLInputElement>('input[name="page_title"]');
      if (pageTitle) pageTitle.value = document.title;
      const timestamp = form.querySelector<HTMLInputElement>(
        'input[name="consent_client_timestamp"]',
      );
      if (timestamp) timestamp.value = new Date().toISOString();
      const offset = form.querySelector<HTMLInputElement>('input[name="consent_timezone_offset"]');
      if (offset) offset.value = String(new Date().getTimezoneOffset());

      const needsPhone = [
        ...form.querySelectorAll<HTMLInputElement>('input[data-requires-phone]'),
      ].some((input) => input.checked);
      const phone = form.querySelector<HTMLInputElement>('input[name="phone"]');
      if (needsPhone && phone && phone.value.trim().length < 7) {
        phone.setCustomValidity('Phone is required when optional SMS or call consent is selected.');
        phone.reportValidity();
        event.preventDefault();
        return;
      }
      if (phone) phone.setCustomValidity('');

      const formName = (form.getAttribute('action') ?? '').includes('free-guide')
        ? 'free-guide'
        : 'book';
      const eventName = formName === 'book' ? 'mrx_book_submit' : 'mrx_free_guide_submit';
      const payload = {
        event: eventName,
        lead_type: formName === 'book' ? 'book_review' : 'free_guide',
        form_id: form.getAttribute('aria-label') || formName,
        form_action: form.getAttribute('action') || '',
        value: 0,
        currency: 'USD',
      };
      window.dataLayer = window.dataLayer || [];
      const mrxPush = (window as any).__mrxPush;
      if (typeof mrxPush === 'function') {
        mrxPush(payload);
        mrxPush({
          event: 'generate_lead',
          lead_type: payload.lead_type,
          form_action: payload.form_action,
        });
        mrxPush({ event: 'form_submit', mrx_form: formName });
      } else {
        window.dataLayer.push(payload);
        window.dataLayer.push({
          event: 'generate_lead',
          lead_type: payload.lead_type,
          form_action: payload.form_action,
        });
        window.dataLayer.push({ event: 'form_submit', mrx_form: formName });
      }
    });
  }
  document.querySelectorAll<HTMLFormElement>('form[method="POST"]').forEach(attachUtmCopy);
</script>
