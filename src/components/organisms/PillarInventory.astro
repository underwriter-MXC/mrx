---
/**
 * PillarInventory organism: reusable downward article list for any of
 * the 9 MRX1000 pillar surfaces. Designed to be appended after a pillar
 * page's primary content/CTA without altering the existing hero/CTA.
 *
 * Inputs:
 *   - inventory: result of `getPillarInventoryPage(pillarId, ...)`;
 *                already fail-closed, already paginated, already sorted.
 *   - heading:   optional eyebrow/heading pair for the section.
 *   - ctaLabel:  optional label for the "View all <N> articles" link
 *                that targets the paginated archive at
 *                `{pillar.path}page/2/` when more pages exist.
 *
 * Emits plain anchor tags (no JS gating) so crawlers can follow without
 * hydration, and uses data attributes for test selectors:
 *   - [data-pillar-inventory] on the section root
 *   - [data-pillar-inventory-card] on each article card
 *   - [data-pillar-inventory-cta] on the "view all" link
 *   - [data-pillar-inventory-pagination] on the pagination region
 */
import PaginationNav from '../seo/PaginationNav.astro';
import type { PillarInventoryPage } from '../../lib/pillar-inventory';

interface Props {
  inventory: PillarInventoryPage;
  heading?: string;
  eyebrow?: string;
  ctaLabel?: string;
  /**
   * Override the "browse all" link target. Defaults to the last
   * archive page (`{pillar.path}page/{lastPage}/`). Static pillar
   * surfaces that don't yet have a paginated archive should pass the
   * canonical cross-pillar destination (Learning Center hub) instead.
   */
  ctaHref?: string;
  /**
   * Whether to render the in-page PaginationNav region. All nine canonical
   * pillar surfaces have count-driven `{pillar.path}/page/{n}/` routes, so
   * normal callers use `auto`. `off` remains available for a deliberately
   * embedded inventory that does not own canonical continuation routes.
   */
  pagination?: 'auto' | 'off';
}

const { inventory, heading, eyebrow, ctaLabel, ctaHref, pagination = 'auto' } = Astro.props;
const { pillar, posts, totalPosts, currentPage, lastPage, pageSize } = inventory;
const showAllLink = lastPage > 1;
const renderPagination = pagination === 'auto' && lastPage > 1;
const archiveBase = `${pillar.path}`;
const fallbackCtaHref = `${archiveBase}page/${lastPage}/`;
const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<section
  class="pillar-inventory"
  data-pillar-inventory
  data-pillar-id={pillar.id}
  data-pillar-total={totalPosts}
  data-pillar-current-page={currentPage}
  data-pillar-last-page={lastPage}
  aria-labelledby={`pillar-inventory-${pillar.id}`}
>
  <div class="container">
    <header class="pillar-inventory__head">
      {eyebrow && <p class="pillar-inventory__eyebrow">{eyebrow}</p>}
      <h2 id={`pillar-inventory-${pillar.id}`}>
        {heading ?? `${totalPosts} reviewed ${pillar.label.toLowerCase()} articles`}
      </h2>
      <p class="pillar-inventory__count">
        Showing <strong>{(currentPage - 1) * pageSize + (posts.length === 0 ? 0 : 1)}</strong>
        through <strong>{(currentPage - 1) * pageSize + posts.length}</strong>
        of <strong>{totalPosts}</strong>
        {totalPosts === 1 ? 'published article' : 'published articles'}
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="pillar-inventory__empty">
          Reviewed articles for {pillar.label.toLowerCase()} publish on the same cadence as the rest
          of the Learning Center. Check back after the next editorial release.
        </p>
      ) : (
        <ul class="pillar-inventory__grid" role="list">
          {posts.map((post) => (
            <li class="pillar-inventory__card" data-pillar-inventory-card={post.slug}>
              <a
                class="pillar-inventory__image"
                href={`/blog/${post.slug}/`}
                aria-label={`Read ${post.title}`}
              >
                <img
                  src={post.heroImage}
                  alt={post.heroAlt}
                  width="1200"
                  height="630"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="pillar-inventory__body">
                <p class="pillar-inventory__meta">
                  <span>{post.categoryLabel}</span>
                  <span>{post.readingMinutes} min read</span>
                </p>
                <h3>
                  <a href={`/blog/${post.slug}/`}>{post.title}</a>
                </h3>
                <p>{post.excerpt}</p>
                <footer>
                  <span>
                    By <a href={`/authors/${post.authorSlug}/`}>{post.author}</a>
                  </span>
                  <time datetime={post.publishedAt}>
                    {dateFmt.format(new Date(post.publishedAt))}
                  </time>
                </footer>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <div class="pillar-inventory__pagination" data-pillar-inventory-pagination={pillar.id}>
      {
        renderPagination && (
          <PaginationNav basePath={archiveBase} currentPage={currentPage} lastPage={lastPage} />
        )
      }
      {
        showAllLink && (
          <a
            class="pillar-inventory__cta"
            href={ctaHref ?? fallbackCtaHref}
            data-pillar-inventory-cta="view-all"
          >
            {ctaLabel ?? `Browse all ${totalPosts} ${pillar.label.toLowerCase()} articles →`}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .pillar-inventory {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid var(--color-ink-100, #d9e0e4);
    background: var(--color-bg-alt, #f6f3ec);
  }

  .pillar-inventory__head {
    max-width: 60ch;
    margin-bottom: var(--space-5, 1.5rem);
  }

  .pillar-inventory__eyebrow {
    margin: 0 0 var(--space-2, 0.5rem);
    color: var(--color-brand-700, #1a3a5f);
    font-size: var(--fs-xs, 0.78rem);
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .pillar-inventory__head h2 {
    margin: 0;
    color: var(--color-brand-900, #071e34);
    font-size: clamp(1.55rem, 2.8vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .pillar-inventory__count {
    margin: var(--space-3, 0.85rem) 0 0;
    color: var(--color-ink-600, #4f626f);
    font-size: 0.92rem;
  }

  .pillar-inventory__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5, 1.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillar-inventory__card {
    display: flex;
    overflow: hidden;
    flex-direction: column;
    border: 1px solid var(--color-ink-100, #d9e0e4);
    border-radius: var(--radius-lg, 16px);
    background: var(--color-white, #fff);
  }

  .pillar-inventory__image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 40 / 21;
    object-fit: contain;
  }

  .pillar-inventory__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--space-2, 0.55rem);
    padding: var(--space-4, 1rem) var(--space-5, 1.2rem) var(--space-5, 1.2rem);
  }

  .pillar-inventory__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    color: var(--color-ink-500, #607682);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pillar-inventory__body h3 {
    margin: 0;
    color: var(--color-brand-900, #071e34);
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .pillar-inventory__body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .pillar-inventory__body p {
    margin: 0;
    color: var(--color-ink-600, #4f626f);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .pillar-inventory__body footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: auto;
    color: var(--color-ink-500, #607682);
    font-size: 0.78rem;
  }

  .pillar-inventory__body footer a {
    color: var(--color-brand-900, #071e34);
    font-weight: 700;
  }

  .pillar-inventory__empty {
    margin: 0;
    color: var(--color-ink-600, #4f626f);
    font-style: italic;
  }

  .pillar-inventory__pagination {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.85rem);
    align-items: center;
    margin-top: var(--space-5, 1.5rem);
  }

  .pillar-inventory__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    border-radius: 999px;
    padding: 0.5rem 1.15rem;
    color: var(--color-brand-900, #071e34);
    background: var(--color-white, #fff);
    border: 1px solid var(--color-ink-100, #d9e0e4);
    font-weight: 700;
    text-decoration: none;
  }

  .pillar-inventory__cta:hover {
    border-color: var(--color-brand-300, #4d7a98);
    background: #eef3f4;
  }

  @media (max-width: 900px) {
    .pillar-inventory__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .pillar-inventory__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
