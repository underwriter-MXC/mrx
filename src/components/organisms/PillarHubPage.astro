---
import type { FaqPair } from '../../lib/astro/content';
import type { PillarTopicGroup } from '../../lib/pillar-hubs';
import type { PillarInventoryPage } from '../../lib/pillar-inventory';
import CtaLink from '../atoms/CtaLink.astro';
import CitedAnswer from '../molecules/CitedAnswer.astro';
import PillarInventory from './PillarInventory.astro';
import PostCard from './PostCard.astro';

type Source = { label: string; href: string };

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  directAnswer: string;
  sources: Source[];
  topics: PillarTopicGroup[];
  faqs: FaqPair[];
  cta: {
    title: string;
    body: string;
    label: string;
    prompt: string;
  };
  /** Optional fail-closed inventory for downward paginated article links. */
  inventory?: PillarInventoryPage;
  /**
   * Optional cap on topic-guide cards shown above the fold. Remaining
   * articles are reachable via the PillarInventory downward section
   * (or, if `inventory` is not provided, via the topic-guide's own
   * "Browse all N articles" link). Defaults to 12 so quota-scale hubs
   * never render every card on a single page.
   */
  maxPostsPerTopic?: number;
}

const {
  eyebrow,
  title,
  lede,
  directAnswer,
  sources,
  topics,
  faqs,
  cta,
  inventory,
  maxPostsPerTopic = 12,
} = Astro.props;
const articleCount = topics.reduce((total, topic) => total + topic.posts.length, 0);
---

<main id="pillar-top" class="pillar-hub" data-pillar-article-count={articleCount}>
  <section class="pillar-hub__hero" aria-labelledby="pillar-title">
    <div class="container pillar-hub__hero-grid">
      <div>
        <p class="pillar-hub__eyebrow">{eyebrow}</p>
        <h1 id="pillar-title">{title}</h1>
        <p class="pillar-hub__lede">{lede}</p>
        <div class="pillar-hub__actions">
          <button type="button" class="btn btn--primary btn--lg" data-pillar-prompt={cta.prompt}>
            Ask Travis about this topic
          </button>
          <CtaLink
            ctaName="pillar-hero-browse-articles"
            href="#topic-guides"
            variant="secondary"
            size="lg"
          >
            Browse {articleCount} reviewed articles
          </CtaLink>
        </div>
      </div>

      <CitedAnswer text={directAnswer} sources={sources} />
    </div>
  </section>

  <nav class="container pillar-hub__topic-nav" aria-label="Browse this topic">
    <div>
      <strong>Start by topic</strong>
      <span>{articleCount} currently published articles</span>
    </div>
    <ul>
      {
        topics.map((topic) => (
          <li>
            <a href={`#${topic.id}`}>
              <span>{topic.title}</span>
              <small>{topic.posts.length} articles</small>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div id="topic-guides" class="pillar-hub__topics">
    {
      topics.map((topic) => {
        const visiblePosts = topic.posts.slice(0, maxPostsPerTopic);
        const overflowCount = topic.posts.length - visiblePosts.length;
        return (
          <section id={topic.id} class="pillar-hub__topic" aria-labelledby={`${topic.id}-title`}>
            <div class="container">
              <header class="pillar-hub__topic-head">
                <div>
                  <p class="pillar-hub__eyebrow">Topic articles</p>
                  <h2 id={`${topic.id}-title`}>{topic.title}</h2>
                </div>
                <p>{topic.description}</p>
              </header>
              <div class="pillar-hub__post-grid">
                {visiblePosts.map((post) => (
                  <PostCard
                    post={{ ...post.data, slug: post.id.replace(/\.mdx?$/, '') }}
                    href={`/blog/${post.id.replace(/\.mdx?$/, '')}/`}
                  />
                ))}
              </div>
              {overflowCount > 0 && (
                <p class="pillar-hub__topic-overflow">
                  <a
                    href={inventory ? `${inventory.pillar.path}page/2/` : '/learning-center/'}
                    data-pillar-topic-overflow={topic.id}
                  >
                    Browse {overflowCount} more {topic.title.toLowerCase()} article
                    {overflowCount === 1 ? '' : 's'} →
                  </a>
                </p>
              )}
            </div>
          </section>
        );
      })
    }
  </div>
  {
    inventory && (
      <PillarInventory
        inventory={inventory}
        eyebrow="Continue exploring"
        heading={`All ${inventory.totalPosts} ${inventory.pillar.label.toLowerCase()} articles`}
        ctaLabel={`Browse every ${inventory.totalPosts} ${inventory.pillar.label.toLowerCase()} article →`}
      />
    )
  }

  <section class="container pillar-hub__review" aria-labelledby="review-title">
    <div>
      <p class="pillar-hub__eyebrow">Editorial review</p>
      <h2 id="review-title">Sources and review responsibility</h2>
      <p>
        Reviewed by <a href="/authors/mrx-editorial-team/">MRX Editorial Team</a>. MRX maintains
        publication responsibility for this hub and its educational framing. Record, title, legal,
        and tax conclusions should be checked against the controlling documents and the qualified
        professional appropriate to the property and transaction.
      </p>
    </div>
    <ul aria-label="Primary sources for this page">
      {
        sources.map((source) => (
          <li>
            <a href={source.href}>{source.label}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container pillar-hub__faq" aria-labelledby="faq-title">
    <header>
      <p class="pillar-hub__eyebrow">Common questions</p>
      <h2 id="faq-title">Frequently asked questions</h2>
    </header>
    <div>
      {
        faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="container pillar-hub__cta" aria-labelledby="pillar-cta-title">
    <div>
      <p class="pillar-hub__eyebrow">Start with a question</p>
      <h2 id="pillar-cta-title">{cta.title}</h2>
      <p>{cta.body}</p>
    </div>
    <div class="pillar-hub__cta-actions">
      <button type="button" class="btn btn--primary btn--lg" data-pillar-prompt={cta.prompt}>
        {cta.label}
      </button>
      <CtaLink ctaName="pillar-cta-book" href="/book/" variant="ghost" size="lg">
        Request a confidential review
      </CtaLink>
    </div>
  </section>
</main>

<script>
  document.querySelectorAll<HTMLElement>('[data-pillar-prompt]').forEach((button) => {
    button.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('mrx:open-chat', { detail: { prompt: button.dataset.pillarPrompt } }),
      );
    });
  });
</script>

<style>
  .pillar-hub {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .pillar-hub__hero {
    padding: clamp(2rem, 5vw, 4.75rem) 0;
    background:
      radial-gradient(circle at 88% 12%, rgba(245, 166, 35, 0.18), transparent 30%),
      linear-gradient(145deg, var(--color-brand-50), var(--color-bg));
    border-bottom: 1px solid var(--color-ink-100);
  }

  .pillar-hub__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(350px, 0.86fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .pillar-hub__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-700);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .pillar-hub__hero h1 {
    max-width: 15ch;
    font-size: clamp(2.35rem, 5.3vw, 4.65rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .pillar-hub__lede {
    max-width: 66ch;
    margin: var(--space-4) 0 0;
    color: var(--color-ink-600);
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    line-height: 1.65;
  }

  .pillar-hub__actions,
  .pillar-hub__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .pillar-hub__hero :global(.cited-answer) {
    margin: 0;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow-md);
  }

  .pillar-hub__topic-nav {
    display: grid;
    grid-template-columns: minmax(190px, 0.33fr) 1fr;
    gap: var(--space-5);
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .pillar-hub__topic-nav > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .pillar-hub__topic-nav > div span {
    color: var(--color-ink-500);
    font-size: var(--fs-sm);
  }

  .pillar-hub__topic-nav ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .pillar-hub__topic-nav a {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--color-brand-900);
    text-decoration: none;
    background: var(--color-white);
    border: 1px solid var(--color-ink-100);
    border-radius: var(--radius-md);
  }

  .pillar-hub__topic-nav a:hover {
    border-color: var(--color-brand-300);
    box-shadow: var(--shadow-sm);
  }

  .pillar-hub__topic-nav span {
    font-weight: var(--fw-semibold);
  }

  .pillar-hub__topic-nav small {
    color: var(--color-ink-500);
  }

  .pillar-hub__topics {
    border-block: 1px solid var(--color-ink-100);
  }

  .pillar-hub__topic {
    padding: clamp(2.75rem, 6vw, 5rem) 0;
    scroll-margin-top: 5rem;
  }

  .pillar-hub__topic:nth-child(odd) {
    background: var(--color-bg-alt);
  }

  .pillar-hub__topic-head {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(280px, 0.6fr);
    gap: var(--space-6);
    align-items: end;
    margin-bottom: var(--space-6);
  }

  .pillar-hub__topic-head h2,
  .pillar-hub__review h2,
  .pillar-hub__faq h2,
  .pillar-hub__cta h2 {
    color: var(--color-brand-900);
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .pillar-hub__topic-head > p,
  .pillar-hub__review p,
  .pillar-hub__cta p {
    color: var(--color-ink-600);
    line-height: 1.65;
  }

  .pillar-hub__post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .pillar-hub__topic-overflow {
    margin: var(--space-5) 0 0;
    text-align: center;
  }

  .pillar-hub__topic-overflow a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    color: var(--color-brand-900);
    background: var(--color-white);
    border: 1px solid var(--color-ink-100);
    font-weight: 700;
    text-decoration: none;
  }

  .pillar-hub__topic-overflow a:hover {
    border-color: var(--color-brand-300);
    background: #eef3f4;
  }

  .pillar-hub__review {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-block: clamp(3rem, 7vw, 6rem);
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-ink-200);
  }

  .pillar-hub__review p {
    max-width: 75ch;
    margin-top: var(--space-3);
  }

  .pillar-hub__review ul {
    display: grid;
    gap: var(--space-3);
    align-content: center;
  }

  .pillar-hub__review li {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-accent-500);
  }

  .pillar-hub__faq {
    display: grid;
    grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .pillar-hub__faq details {
    border-top: 1px solid var(--color-ink-200);
  }

  .pillar-hub__faq details:last-child {
    border-bottom: 1px solid var(--color-ink-200);
  }

  .pillar-hub__faq summary {
    padding: var(--space-4) var(--space-1);
    color: var(--color-brand-900);
    font-weight: var(--fw-semibold);
    cursor: pointer;
  }

  .pillar-hub__faq details p {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-ink-600);
    line-height: 1.65;
  }

  .pillar-hub__cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-white);
    background: var(--color-brand-900);
    border-radius: var(--radius-lg);
  }

  .pillar-hub__cta h2 {
    color: var(--color-white);
  }

  .pillar-hub__cta p {
    max-width: 65ch;
    margin-top: var(--space-3);
    color: var(--color-ink-200);
  }

  .pillar-hub__cta-actions {
    justify-content: flex-end;
    margin-top: 0;
  }

  .pillar-hub__cta :global(.btn--ghost) {
    color: var(--color-white);
    border-color: var(--color-ink-300);
  }

  @media (max-width: 900px) {
    .pillar-hub__hero-grid,
    .pillar-hub__topic-nav,
    .pillar-hub__topic-head,
    .pillar-hub__review,
    .pillar-hub__faq,
    .pillar-hub__cta {
      grid-template-columns: 1fr;
    }

    .pillar-hub__topic-nav ul,
    .pillar-hub__post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillar-hub__cta-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 620px) {
    .pillar-hub__hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .pillar-hub__topic-nav ul,
    .pillar-hub__post-grid {
      grid-template-columns: 1fr;
    }

    .pillar-hub__actions > *,
    .pillar-hub__cta-actions > * {
      width: 100%;
      justify-content: center;
    }
  }
</style>
