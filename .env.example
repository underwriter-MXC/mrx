# Public site analytics and account client. GT-WFMD2MXW is public, not secret.
PUBLIC_GOOGLE_TAG_ID=GT-WFMD2MXW
# Optional server-side lifecycle events (appointment_held and case_ready).
# Create GA4_API_SECRET in GA4; never expose it through a PUBLIC_ variable.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Legacy deployment alias; PUBLIC_GOOGLE_TAG_ID takes precedence.
PUBLIC_GTM_ID=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_COMPLEX_MODEL=gpt-5.6-terra
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_FACT_MODEL=gpt-5.6-luna

# Anthropic API (Daryl-only: create a dedicated MRX key; never reuse a shared Hermes key.)
ANTHROPIC_API_KEY=

# Supabase server access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Read-only MRX MCP. The stdio transport needs only the Supabase values above.
# HTTP bearer mode is for local/development verification; public production use must sit behind OAuth 2.1.
MRX_MCP_AUDIT_ENABLED=true
MRX_MCP_HOST=127.0.0.1
MRX_MCP_PORT=8788
MRX_MCP_BEARER_TOKEN=
MRX_MCP_ALLOWED_HOSTS=localhost:8788,127.0.0.1:8788
MRX_MCP_ALLOWED_ORIGINS=
MRX_MCP_RATE_LIMIT_PER_MINUTE=60
MRX_MCP_MAX_BODY_BYTES=1048576

# GoHighLevel private integration. The token needs contacts.write,
# conversations/message.write, calendars.readonly, calendars/events.write,
# and webhook scopes for the configured sub-account.
GHL_PRIVATE_INTEGRATION_TOKEN=
# Backward-compatible alias used by some local operator shells.
GHL_API_TOKEN=
# Optional: the server can resolve this from the configured calendar.
GHL_LOCATION_ID=
# Existing MRX GoHighLevel booking calendar (the server verifies it belongs to the configured location).
GHL_CALENDAR_ID=mEqrbWIelaS7o5TMsqUX
# Optional GHL user ID to assign newly created appointments.
GHL_ASSIGNED_USER_ID=
# Verified sender for requested owner emails and appointment confirmations.
GHL_EMAIL_FROM=underwriter@mineralrightsxchange.com
# Existing GHL workflow enrolled after each website appointment is created.
GHL_APPOINTMENT_WORKFLOW_ID=
# Optional GHL workflow for free-guide submissions. It should only branch into SMS when
# contact.mrx_sms_permission is true and must not place AI/prerecorded calls unless
# contact.mrx_call_permission/contact.mrx_ai_voice_permission is true.
GHL_FREE_GUIDE_WORKFLOW_ID=
# Optional canonical guide PDF/file URL. If unset, the site uses /guides/how-to-find-out-what-your-mineral-rights-are.pdf.
MRX_PDF_URL=
# GHL workflow containing the disclosed Voice AI action for owner-requested case updates.
# Keep disabled until phone verification, revocation, recording, and legal review pass.
GHL_AI_VOICE_ENABLED=false
GHL_AI_VOICE_WORKFLOW_ID=
GHL_WEBHOOK_PUBLIC_KEY=
# Optional existing GHL pipeline and stage IDs. The site never invents these values.
GHL_PROSPECTS_PIPELINE_ID=
GHL_PROSPECTS_CONTACTED_STAGE_ID=
GHL_APPOINTMENTS_PIPELINE_ID=
GHL_APPOINTMENT_BOOKED_STAGE_ID=
GHL_SELLERS_PIPELINE_ID=
GHL_SELLERS_OFFER_SENT_STAGE_ID=
# Optional JSON object keyed by staff owner-case status. Values must be real GHL
# pipeline/stage IDs or names from the MRX location; leave unset when GHL secrets
# or live stage IDs are unavailable. Example:
# {"intake":{"pipelineId":"YOUR_GHL_PIPELINE_ID","stageId":"YOUR_GHL_STAGE_ID","pipelineName":"Prospects","stageName":"Record Added"}}
MRX_GHL_OWNER_CASE_STAGE_MAP_JSON=

# Production legal/editorial release receipts. Use:
# approved:reviewer-id:YYYY-MM-DD
MRX_LEGAL_SIGNOFF_1031=
MRX_LEGAL_SIGNOFF_AI_VOICE=
MRX_LEGAL_SIGNOFF_RECORDING=
MRX_LEGAL_SIGNOFF_SELLER_BUYER=
MRX_EDITORIAL_SIGNOFF_UNDERWRITER_FAIR_VALUE=
MRX_ENFORCE_LEGAL_SIGNOFFS=false

# Optional staging-only 100-owner validation. Never configure these in production.
MRX_TEST_MODE=false
MRX_STAGING_TEST_SECRET=
MRX_STAGING_BASE_URL=
# Optional local runner credential for a Vercel-protected Preview. Never configure this in Vercel.
MRX_STAGING_VERCEL_BYPASS=
MRX_TEST_SUPPRESS_OUTBOUND=true
MRX_TEST_SYNC_GHL=false

# Private document processing. Uploads remain disabled until all four values exist.
DOCUMENT_UPLOADS_ENABLED=false
DOCUMENT_WORKER_URL=
DOCUMENT_WORKER_TOKEN=
DOCUMENT_WORKER_CALLBACK_SECRET=
# 32-byte base64 key reserved for encrypting any retained raw extraction payload.
DOCUMENT_ENCRYPTION_KEY=

# Server-only cleanup endpoint authorization
MAINTENANCE_CRON_SECRET=
# Vercel sets CRON_SECRET for authenticated scheduled requests.
CRON_SECRET=
